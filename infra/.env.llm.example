# Reaches only llm-gateway. Provider keys live here and nowhere else (FR-1.3).
GEMINI_API_KEY=your-gemini-developer-api-key
LITELLM_MASTER_KEY=generated
LITELLM_SALT_KEY=generated
LITELLM_DATABASE_URL=postgresql://litellm:generated@postgres:5432/litellm

# Model IDs are chosen only after `make live-check-gemini` shows the key can generate with them (FR-11.5).
GEMINI_FLASH_MODEL=
GEMINI_FLASH_LITE_MODEL=
