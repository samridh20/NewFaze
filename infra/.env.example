# Shared settings. `make env` generates infra/.env with random secrets (mode 600). Placeholders only here.
APP_ENV=local
DEMO_MODE=1

# One PostgreSQL cluster, four schemas, one login role per service (FR-3.1).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=faze
OWNER_DB_PASSWORD=generated
ODYSSEY_DB_PASSWORD=generated
LAB_DB_PASSWORD=generated
RELAY_DB_PASSWORD=generated
WORKERS_DB_PASSWORD=generated

REDIS_URL=redis://localhost:6379/0

# Auth. In DEMO_MODE the issuer is the local dev-auth service.
SUPABASE_URL=
SUPABASE_JWKS_URL=http://localhost:8003/.well-known/jwks.json
JWT_ISSUER=http://localhost:8003
JWT_AUDIENCE=faze
DEV_AUTH_URL=http://localhost:8003

ODYSSEY_INTERNAL_TOKEN_SECRET=generated
IP_HASH_SECRET=generated
COUNCIL_LINK_SECRET=generated
TRUSTED_PROXIES=

ODYSSEY_PUBLIC_URL=http://localhost:8001
ODYSSEY_INTERNAL_URL=http://127.0.0.1:8011
SIGNAL_LAB_URL=http://localhost:8002

# Media. Empty Mux values mean the local HLS adapter is used (DEMO_MODE only).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# LLM router. Native runs point at the fixture gateway, compose runs at LiteLLM.
LITELLM_URL=http://localhost:4010/v1
